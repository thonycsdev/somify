{
  "name": "somify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:start && next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watchAll --runInBand",
    "db:start": "docker compose -f infra/compose.yml --env-file .env.development up -d --remove-orphans && node --env-file=.env.development infra/scripts/wait-for-postgres.js",
    "migrate:up": "pnpm db:start && dotenv -e .env.development -- node-pg-migrate -m migrations up",
    "migrate:up:prod": "node-pg-migrate -m migrations up",
    "migrate:down": "pnpm db:start && dotenv -e .env.development -- node-pg-migrate -m migrations down",
    "migrate:create": "dotenv -e .env.development -- node-pg-migrate -m migrations create",
    "test:integration": "pnpm db:start && pnpm migrate:up && concurrently -k -s second \"next dev\" \"jest --runInBand\"",
    "lint": "biome lint .",
    "lint:check": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@chakra-ui/react": "^3.36.1",
    "@emotion/react": "^11.14.0",
    "bcrypt": "^6.0.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@faker-js/faker": "^10.4.0",
    "@swc/core": "^1.15.33",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/set-cookie-parser": "^2.4.10",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.4.2",
    "set-cookie-parser": "^3.1.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
